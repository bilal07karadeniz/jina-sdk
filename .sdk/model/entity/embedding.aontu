    }
    usage: {
      h: "Usage"
      n: "usage"
      r: true
      sh: "Token usage statistics."
      t: "`$ANY`"
      union: {
        branches: 3
        count: 1
        depth: 0
      }
    }
  }

  name: "embedding"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "dimensions"
